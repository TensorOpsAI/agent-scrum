# Database
DATABASE_URL=sqlite+aiosqlite:///./agent_scrum.db

# Gemini API - Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Simulation mode - set to true to use mock responses instead of Gemini API
SIMULATE_MODE=true

# Server
HOST=0.0.0.0
PORT=8000
